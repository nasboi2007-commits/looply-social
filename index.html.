<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#081525" />
  <title>Looply — Social, your way</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    :root {
      --bg: #071426;
      --panel: #0d2036;
      --panel-2: #102741;
      --line: #1d3854;
      --blue: #1684f8;
      --blue-2: #0868df;
      --text: #edf4ff;
      --muted: #91a5bd;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at 85% 18%, rgba(0, 100, 220, .15), transparent 27rem),
        radial-gradient(circle at 12% 75%, rgba(0, 72, 160, .10), transparent 25rem),
        var(--bg);
      font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 10;
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 max(5%, calc((100% - 1120px) / 2));
      background: rgba(7, 20, 38, .88);
      border-bottom: 1px solid rgba(50, 83, 118, .55);
      backdrop-filter: blur(14px);
    }
    .brand { display: flex; align-items: center; gap: 11px; font-size: 21px; font-weight: 800; letter-spacing: -.7px; }
    .brand-mark {
      display: grid; place-items: center; width: 38px; height: 38px;
      border-radius: 13px; color: white; font-size: 22px;
      background: linear-gradient(145deg, #31a5ff, #0864dc);
      box-shadow: 0 7px 22px rgba(0, 115, 255, .28);
    }
    .nav { display: flex; align-items: center; gap: 34px; color: #c1cede; font-size: 14px; }
    .nav a { transition: color .2s; }
    .nav a:hover, .nav a.active { color: #fff; }
    .nav a.active { position: relative; }
    .nav a.active::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: -29px;
      height: 3px; border-radius: 5px; background: var(--blue);
    }
    .login {
      border: 0; color: white; background: linear-gradient(135deg, #168cff, #0868e6);
      border-radius: 24px; padding: 11px 22px; font-weight: 600;
      box-shadow: 0 6px 20px rgba(0, 111, 255, .2);
    }
    .menu-btn { display: none; border: 1px solid var(--line); color: white; background: var(--panel); border-radius: 10px; padding: 8px 11px; }
    .auth-modal { display:none; position:fixed; inset:0; z-index:30; background:rgba(0,0,0,.72); padding:18px; align-items:center; justify-content:center; }
    .auth-modal.open { display:flex; }
    .auth-card { width:min(430px,100%); background:#0d2036; border:1px solid #294766; border-radius:20px; padding:25px; box-shadow:0 24px 80px rgba(0,0,0,.45); }
    .auth-card h2 { margin:0 0 7px; font-size:24px; }
    .auth-card p { color:var(--muted); font-size:13px; line-height:1.6; }
    .auth-card label { display:block; margin:14px 0 6px; color:#dce7f5; font-size:12px; }
    .auth-card input { width:100%; padding:13px 14px; border:1px solid #29435f; border-radius:10px; color:white; background:#071426; outline:none; }
    .auth-card input:focus { border-color:#168cff; }
    .auth-actions { display:flex; gap:10px; margin-top:18px; }
    .auth-actions button { flex:1; border:0; border-radius:11px; padding:12px; color:white; background:#0878ef; font-weight:700; }
    .auth-actions .quiet { background:#193550; }
    .auth-note { min-height:20px; margin-top:12px; color:#9fcaff; font-size:12px; overflow-wrap:anywhere; }
    .auth-top { display:flex; justify-content:space-between; align-items:center; }
    .close-auth { border:0; background:transparent; color:#b9cbe0; font-size:24px; }

    .wrap { width: min(1100px, 90%); margin: 0 auto; }
    .hero {
      position: relative; overflow: hidden; display: grid; grid-template-columns: 1.15fr .85fr;
      align-items: center; gap: 35px; min-height: 485px; padding: 76px 0 55px;
    }
    .hero::before, .hero::after {
      content: ""; position: absolute; border-radius: 50%; pointer-events: none;
      background: linear-gradient(145deg, rgba(20, 126, 255, .30), rgba(0, 68, 158, .05));
      border: 1px solid rgba(44, 139, 255, .13);
    }
    .hero::before { width: 170px; height: 170px; right: -60px; top: 110px; }
    .hero::after { width: 52px; height: 52px; right: 90px; top: 62px; }
    .hero-copy { position: relative; z-index: 1; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px;
      color: #d8eaff; background: rgba(25, 87, 151, .28);
      border: 1px solid rgba(60, 139, 225, .16); border-radius: 20px; font-size: 12px; font-weight: 600;
    }
    h1 { margin: 20px 0 8px; font-size: clamp(48px, 7vw, 68px); line-height: 1; letter-spacing: -3.8px; }
    h1 span { color: #238cff; }
    .hero h2 { margin: 0 0 15px; font-size: clamp(27px, 4vw, 39px); line-height: 1.15; letter-spacing: -1.5px; }
    .lead { max-width: 480px; margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; }
    .actions { display: flex; gap: 14px; margin-top: 25px; flex-wrap: wrap; }
    .primary, .secondary {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      border-radius: 28px; padding: 13px 22px; font-size: 14px; font-weight: 600;
      transition: transform .2s, background .2s;
    }
    .primary { color: white; background: linear-gradient(135deg, #168cff, #0868e6); border: 1px solid transparent; box-shadow: 0 8px 24px rgba(0, 111, 255, .2); }
    .secondary { color: #d9e5f5; background: transparent; border: 1px solid #29435f; }
    .primary:hover, .secondary:hover { transform: translateY(-2px); }
    .hero-art { min-height: 290px; display: grid; place-items: center; position: relative; }
    .orbit {
      width: 270px; height: 270px; border-radius: 50%; border: 1px solid rgba(43, 133, 255, .2);
      display: grid; place-items: center; box-shadow: 0 0 75px rgba(0, 99, 255, .12), inset 0 0 55px rgba(0, 99, 255, .08);
      background: radial-gradient(circle, rgba(16, 76, 145, .2), transparent 68%);
    }
    .orbit-inner {
      width: 176px; height: 176px; display: grid; place-items: center; border-radius: 42px;
      transform: rotate(-8deg); background: linear-gradient(145deg, #188fff, #0752bd);
      box-shadow: 0 20px 55px rgba(0, 91, 220, .35);
      font-size: 72px;
    }
    .float-dot { position: absolute; width: 14px; height: 14px; border-radius: 50%; background: #0878ef; box-shadow: 0 0 22px #0878ef; }
    .dot-one { top: 35px; right: 12%; } .dot-two { bottom: 38px; left: 12%; width: 9px; height: 9px; }

    .features { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 5px 0 44px; }
    .feature { text-align: center; color: #dce7f5; }
    .feature-icon {
      width: 48px; height: 48px; margin: 0 auto 10px; display: grid; place-items: center;
      border-radius: 50%; color: #2995ff; background: rgba(12, 87, 164, .22); font-size: 22px;
      border: 1px solid rgba(31, 120, 215, .12);
    }
    .feature strong { display: block; font-size: 14px; margin-bottom: 5px; }
    .feature small { color: var(--muted); font-size: 11px; }

    .trending {
      margin: 0 0 42px; padding: 22px 24px 12px; border-radius: 16px;
      background: linear-gradient(145deg, rgba(17, 42, 68, .94), rgba(10, 29, 50, .96));
      border: 1px solid rgba(40, 75, 111, .65); box-shadow: 0 12px 35px rgba(0, 0, 0, .16);
    }
    .trend-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .trend-head h3 { margin: 0; font-size: 17px; }
    .trend-head a { color: #268fff; font-size: 12px; font-weight: 600; }
    .trend-item {
      display: flex; align-items: center; gap: 14px; padding: 12px 2px;
      border-bottom: 1px solid rgba(54, 83, 113, .28); transition: padding .2s;
    }
    .trend-item:last-child { border-bottom: 0; }
    .trend-item:hover { padding-left: 8px; }
    .trend-icon { flex: 0 0 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; font-size: 20px; color: white; }
    .code { background: linear-gradient(145deg, #7b9ab8, #315779); }
    .leaf { background: linear-gradient(145deg, #36d68c, #078b5a); }
    .music { background: linear-gradient(145deg, #d34bff, #7926d5); }
    .trend-info { flex: 1; }
    .trend-info strong { display: block; font-size: 13px; margin-bottom: 4px; }
    .trend-info small { color: var(--muted); font-size: 11px; }
    .arrow { color: #8da4bd; font-size: 22px; }
    footer {
      border-top: 1px solid rgba(45, 75, 108, .45); padding: 20px 0 25px;
      color: #8195ad; font-size: 11px;
    }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 15px; }
    .socials { display: flex; gap: 17px; color: #238cff; font-size: 15px; font-weight: 700; }

    @media (max-width: 700px) {
      .topbar { height: 66px; padding: 0 5%; }
      .menu-btn { display: block; }
      .nav {
        display: none; position: absolute; top: 65px; left: 0; right: 0; padding: 20px 5%;
        flex-direction: column; align-items: flex-start; gap: 20px; background: #0a1b30;
        border-bottom: 1px solid var(--line);
      }
      .nav.open { display: flex; }
      .nav a.active::after { display: none; }
      .login { padding: 9px 15px; }
      .hero { grid-template-columns: 1fr; padding: 58px 0 28px; gap: 5px; }
      .hero-art { min-height: 230px; }
      .orbit { width: 205px; height: 205px; }
      .orbit-inner { width: 132px; height: 132px; border-radius: 32px; font-size: 55px; }
      .features { grid-template-columns: repeat(2, 1fr); row-gap: 25px; padding-bottom: 34px; }
      .trending { padding: 18px 16px 8px; }
      .footer-inner { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 380px) {
      .brand { font-size: 18px; }
      .brand-mark { width: 34px; height: 34px; }
      .login { font-size: 12px; }
      .lead { font-size: 14px; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#home" aria-label="Looply home">
      <span class="brand-mark">∞</span><span>Looply</span>
    </a>
    <button class="menu-btn" id="menuBtn" aria-label="Toggle navigation" aria-expanded="false">☰</button>
    <nav class="nav" id="nav">
      <a class="active" href="#home">Home</a>
      <a href="#trending">Explore</a>
      <a href="#about">About</a>
    </nav>
    <div style="display:flex;align-items:center;gap:10px">
      <span id="userLabel" style="font-size:12px;color:#b9cbe0"></span>
      <button class="login" id="authOpenBtn">Login / Sign up</button>
      <button class="login" id="logoutBtn" style="display:none">Log out</button>
    </div>
  </header>

  <main class="wrap" id="home">
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">👥 &nbsp; Social Network</span>
        <h1><span>Looply</span></h1>
        <h2>Social, your way</h2>
        <p class="lead">Connect, share, and be yourself. Looply brings you closer to the people and communities that matter.</p>
        <div class="actions">
          <a class="primary" href="#trending">Get Started <span>→</span></a>
          <a class="secondary" href="#about">Learn More</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="float-dot dot-one"></span><span class="float-dot dot-two"></span>
        <div class="orbit"><div class="orbit-inner">∞</div></div>
      </div>
    </section>

    <section class="features" id="about" aria-label="Looply features">
      <div class="feature"><div class="feature-icon">♧</div><strong>Connect</strong><small>Meet new people</small></div>
      <div class="feature"><div class="feature-icon">☏</div><strong>Share</strong><small>Post your thoughts</small></div>
      <div class="feature"><div class="feature-icon">◈</div><strong>Be Safe</strong><small>Your privacy matters</small></div>
      <div class="feature"><div class="feature-icon">ϟ</div><strong>Grow</strong><small>Build your community</small></div>
    </section>

    <section class="trending" id="trending">
      <div class="trend-head"><h3>🔥 Trending Now</h3><a href="#trending" onclick="showMessage('More communities will appear here soon.')">See all →</a></div>
      <a class="trend-item" href="#trending" onclick="showMessage('Opening the #Tech community soon!')">
        <span class="trend-icon code">&lt;/&gt;</span>
        <span class="trend-info"><strong>#Tech</strong><small>2.4k posts • 3.1k members</small></span><span class="arrow">›</span>
      </a>
      <a class="trend-item" href="#trending" onclick="showMessage('Opening the #Lifestyle community soon!')">
        <span class="trend-icon leaf">✓</span>
        <span class="trend-info"><strong>#Lifestyle</strong><small>1.8k posts • 2.2k members</small></span><span class="arrow">›</span>
      </a>
      <a class="trend-item" href="#trending" onclick="showMessage('Opening the #Music community soon!')">
        <span class="trend-icon music">♫</span>
        <span class="trend-info"><strong>#Music</strong><small>1.2k posts • 1.5k members</small></span><span class="arrow">›</span>
      </a>
    </section>
  </main>


  <div class="auth-modal" id="authModal" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <div class="auth-card">
      <div class="auth-top">
        <div><h2 id="authTitle">Welcome to Looply</h2><p id="authSubtitle">Create an account or log in.</p></div>
        <button class="close-auth" id="authCloseBtn" aria-label="Close">&times;</button>
      </div>
      <form id="authForm">
        <label for="authEmail">Email address</label>
        <input id="authEmail" type="email" autocomplete="email" placeholder="you@example.com" required />
        <label for="authPassword">Password</label>
        <input id="authPassword" type="password" autocomplete="current-password" minlength="6" placeholder="At least 6 characters" required />
        <div class="auth-actions">
          <button type="button" id="signInBtn">Log in</button>
          <button type="button" id="signUpBtn" class="quiet">Create account</button>
        </div>
      </form>
      <div class="auth-note" id="authMessage" aria-live="polite"></div>
    </div>
  </div>

  <footer>
    <div class="wrap footer-inner">
      <span>© 2025 Looply. All rights reserved.</span>
      <div class="socials" aria-label="Social links"><a href="#home" aria-label="Twitter">♥</a><a href="#home" aria-label="Instagram">◎</a><a href="#home" aria-label="YouTube">▶</a><a href="#home" aria-label="TikTok">♪</a><a href="#home" aria-label="Website">◎</a></div>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('menuBtn');
    const nav = document.getElementById('nav');
    menuBtn.addEventListener('click', () => {
      const opened = nav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(opened));
    });
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
      nav.classList.remove('open');
      menuBtn.setAttribute('aria-expanded', 'false');
    }));
  </script>

  <script type="module">
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

    // These are your project's browser-safe URL and publishable key.
    const SUPABASE_URL = 'https://fmnlkovksnwmyultyohe.supabase.co';
    const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_V9UwQqCiwQ6EoGivIjBg3A_OrAvcJuq';
    const supabase = createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

    const modal = document.getElementById('authModal');
    const message = document.getElementById('authMessage');
    const emailInput = document.getElementById('authEmail');
    const passwordInput = document.getElementById('authPassword');
    const openBtn = document.getElementById('authOpenBtn');
    const logoutBtn = document.getElementById('logoutBtn');
    const userLabel = document.getElementById('userLabel');

    function showAuthMessage(text, isError = false) {
      message.textContent = text;
      message.style.color = isError ? '#ff9a9a' : '#9fcaff';
    }
    function openAuth() {
      modal.classList.add('open');
      showAuthMessage('');
    }
    function closeAuth() { modal.classList.remove('open'); }

    openBtn.addEventListener('click', openAuth);
    document.getElementById('authCloseBtn').addEventListener('click', closeAuth);
    modal.addEventListener('click', event => { if (event.target === modal) closeAuth(); });

    document.getElementById('signUpBtn').addEventListener('click', async () => {
      const email = emailInput.value.trim();
      const password = passwordInput.value;
      if (!email || password.length < 6) {
        showAuthMessage('Enter a valid email and a password with at least 6 characters.', true);
        return;
      }
      showAuthMessage('Creating your account…');
      const { data, error } = await supabase.auth.signUp({ email, password });
      if (error) return showAuthMessage(error.message, true);
      if (data.session) {
        showAuthMessage('Account created! You are now logged in.');
        closeAuth();
      } else {
        showAuthMessage('Account created. Check your email for the confirmation link, then log in.');
      }
    });

    document.getElementById('signInBtn').addEventListener('click', async () => {
      const email = emailInput.value.trim();
      const password = passwordInput.value;
      if (!email || !password) {
        showAuthMessage('Enter your email and password.', true);
        return;
      }
      showAuthMessage('Logging in…');
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) return showAuthMessage(error.message, true);
      showAuthMessage('Welcome back!');
      closeAuth();
    });

    logoutBtn.addEventListener('click', async () => {
      const { error } = await supabase.auth.signOut();
      if (error) alert(error.message);
    });

    async function refreshUser() {
      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        userLabel.textContent = user.email;
        openBtn.style.display = 'none';
        logoutBtn.style.display = 'inline-block';
      } else {
        userLabel.textContent = '';
        openBtn.style.display = 'inline-block';
        logoutBtn.style.display = 'none';
      }
    }

    supabase.auth.onAuthStateChange(() => refreshUser());
    await refreshUser();
  </script>
</body>
</html>
